rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn() { return request.auth != null; }
  function belongs(groupId) { return signedIn() && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds; }
  match /users/{uid} { allow read: if signedIn() && request.auth.uid == uid; allow write: if false; }
  match /groups/{groupId} {
   allow read: if signedIn() && request.auth.uid in resource.data.memberIds;
   allow write: if false;
   match /{collection}/{record} {
    allow read: if collection in ['members','expenses','settlements','activity','invites'] && belongs(groupId);
    allow write: if false;
   }
  }
  match /{document=**} { allow read, write: if false; }
 }
}
